<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- CI-produced packages are restored from this local folder during test runs. -->
    <add key="local-artifacts" value="artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-artifacts">
      <package pattern="FFmpegSharpApi*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
