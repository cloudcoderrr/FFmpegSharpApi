# Pinned upstream sources for the native FFmpeg build.
# Sourced by the build scripts and referenced by the build-native workflow.
# Each component is cloned with git at the pinned ref, then patched from
# patches/<component>/ with `git apply`.

# FFmpeg itself (ABI-matched to the FFmpeg.AutoGen 9.0.1.1 managed bindings).
FFMPEG_REPO=https://github.com/FFmpeg/FFmpeg.git
FFMPEG_REF=n9.0.1

# AV1 software decoder (BSD-2, LGPL-compatible). Enables the AV1 fixtures.
DAV1D_REPO=https://code.videolan.org/videolan/dav1d.git
DAV1D_REF=1.5.1

# XML parser used by the MPEG-DASH demuxer (MIT, LGPL-compatible).
LIBXML2_REPO=https://github.com/GNOME/libxml2.git
LIBXML2_REF=v2.13.5

# Subtitle renderer for the burn-in filter (ISC, LGPL-compatible) and its deps.
LIBASS_REPO=https://github.com/libass/libass.git
LIBASS_REF=0.17.3
FREETYPE_REPO=https://gitlab.freedesktop.org/freetype/freetype.git
FREETYPE_REF=VER-2-13-3
FRIBIDI_REPO=https://github.com/fribidi/fribidi.git
FRIBIDI_REF=v1.0.16
HARFBUZZ_REPO=https://github.com/harfbuzz/harfbuzz.git
HARFBUZZ_REF=10.1.0

# GPL-only encoders. Only built for the GPL package variant.
X264_REPO=https://code.videolan.org/videolan/x264.git
X264_REF=stable
X265_REPO=https://bitbucket.org/multicoreware/x265_git.git
X265_REF=4.1
