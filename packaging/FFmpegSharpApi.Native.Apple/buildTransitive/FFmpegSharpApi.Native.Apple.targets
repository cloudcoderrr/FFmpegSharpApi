<Project>
  <!--
    Links the bundled static FFmpeg.xcframework into iOS and Mac Catalyst app heads.
    ForceLoad ensures all FFmpeg symbols are available for the __Internal P/Invoke used
    by the statically linked bindings.
  -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'ios' Or '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'maccatalyst'">
    <NativeReference Include="$(MSBuildThisFileDirectory)..\lib\FFmpeg.xcframework">
      <Kind>Static</Kind>
      <ForceLoad>True</ForceLoad>
      <SmartLink>False</SmartLink>
      <Frameworks>AudioToolbox VideoToolbox CoreMedia CoreVideo CoreImage CoreFoundation Security</Frameworks>
    </NativeReference>
  </ItemGroup>

  <!-- FFmpeg's static libraries also pull in these system libraries (bzip2/zlib/iconv). -->
  <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'ios' Or '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'maccatalyst'">
    <MtouchExtraArgs>$(MtouchExtraArgs) -gcc_flags "-lbz2 -lz -liconv"</MtouchExtraArgs>
  </PropertyGroup>
</Project>
