<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FFmpegSharpApi.Tests.Maui.MainPage">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <Label x:Name="HeaderLabel" Grid.Row="0" FontSize="13" Text="FFmpegSharpApi mobile tests" />
        <Label x:Name="SummaryLabel" Grid.Row="1" FontSize="16" FontAttributes="Bold" Text="Preparing…" />
        <CollectionView x:Name="ResultsView" Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Label Text="{Binding}" FontSize="11" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
